# ---- Server ----
PORT=8080
NODE_ENV=development

# ---- Supabase ----
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
SUPABASE_JWT_SECRET=super-long-random-string

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=1234567890:AA...
ADMIN_TELEGRAM_ID=123456789
# Bot username without @. Used to redirect buyers back into the Mini
# App after an external payment (Stripe). Set this even if you skip
# Stripe — it improves the cancel/success UX.
TELEGRAM_BOT_USERNAME=YourBotUsername

# ---- CORS / URLs ----
CLIENT_ORIGIN=https://your-store.vercel.app
MINI_APP_URL=https://your-store.vercel.app

# ---- Stripe (optional) ----
# From Stripe Dashboard → Developers → API keys → Secret key.
# Required only if you enable the Stripe provider in Admin → Settings.
STRIPE_SECRET_KEY=sk_live_...
# From Stripe Dashboard → Developers → Webhooks → your endpoint → Signing secret.
STRIPE_WEBHOOK_SECRET=whsec_...
