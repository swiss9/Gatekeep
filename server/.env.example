# ---- Server ----
PORT=8080
NODE_ENV=development

# ---- Supabase ----
# Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# Project Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=super-long-random-string

# ---- Telegram ----
# From @BotFather
TELEGRAM_BOT_TOKEN=1234567890:AA...
# Your personal Telegram user id, from @userinfobot. This account is
# always forced to superadmin on login — it is the owner escape hatch.
ADMIN_TELEGRAM_ID=123456789

# ---- CORS ----
# The deployed Vercel URL of the client. In dev, any origin is allowed.
CLIENT_ORIGIN=https://your-store.vercel.app
