{
  "name": "gatekeep-shop-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Gatekeep Shop — Telegram Mini App commerce server",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:bun": "bun src/index.ts",
    "start:node": "node --experimental-strip-types src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@supabase/supabase-js": "^2.45.4",
    "fastify": "^5.0.0",
    "jose": "^5.9.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "typescript": "^5.9.2"
  }
}
